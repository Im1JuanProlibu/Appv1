{
  "expo": {
    "name": "Prolibu V1",
    "slug": "prolibu-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.prolibu.v1"
    },
    "ios": {
      "bundleIdentifier": "com.prolibu.v1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Para notificarte cuando un cliente está viendo tu propuesta."
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4285F4",
          "sounds": []
        }
      ]
    ]
  }
}
