{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "submit": {
    "production": {
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "distribution": "store"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
